{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListTheStore",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::${BUCKET}"
    },
    {
      "Sid": "ReadTheStore",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::${BUCKET}/*"
    },
    {
      "Sid": "WriteResultsAndShardRecordsOnly",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": [
        "arn:aws:s3:::${BUCKET}/objects/*",
        "arn:aws:s3:::${BUCKET}/jobs/*/shards/*",
        "arn:aws:s3:::${BUCKET}/jobs/*/logs/*"
      ]
    }
  ]
}
