{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListTheTrainedIdsOnly",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::${BUCKET}",
      "Condition": { "StringLike": { "s3:prefix": ["private/trained-ids/*/releases/*"] } }
    },
    {
      "Sid": "ReadTheTrainedIdsOnly",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::${BUCKET}/private/trained-ids/*/releases/*"
    }
  ]
}
