# /etc/atlas/atlas.env on the Atlas server: root:atlas, mode 640.
# Read by `docker run --env-file`: one KEY=value per line, no quotes, no
# spaces around "=", and a PEM written on one line with literal \n.
# Never commit the filled-in file.

# --- the store and AWS ---------------------------------------------------
ATLAS_STORE=s3://<bucket>
AWS_REGION=us-east-2
# atlas-orchestrator's access key (deploy/aws/README.md). Create it in the
# AWS console and paste it here; it goes nowhere else.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- EC2 workers (deploy/aws/README.md, "The box's settings") -------------
ATLAS_EC2_REGION=us-east-2
ATLAS_EC2_SUBNETS=<subnet-…>,<subnet-…>,<subnet-…>
ATLAS_EC2_SECURITY_GROUP=<sg-…>
ATLAS_EC2_INSTANCE_PROFILE=atlas-worker
ATLAS_EC2_MAX_WORKERS=4
ATLAS_EC2_MAX_HOURS=6

# --- the site and sign-in ----------------------------------------------
ATLAS_PUBLIC_ORIGIN=https://atlas.mycomap.org
# Any site may call the public API from a page. Safe: no answer carries
# Access-Control-Allow-Credentials, so such calls never ride a visitor's session.
ATLAS_ALLOWED_ORIGINS=*
# mycomap.org's sign-in bridge PUBLIC key (the one dev.mycomap.org holds).
ATLAS_BRIDGE_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n…\n-----END PUBLIC KEY-----
# Signs Atlas's own session cookie. Generate on the server, 32+ characters:
#   openssl rand -base64 48
ATLAS_SESSION_SECRET=
# Shared with mycomap.org (its ATLAS_INTROSPECTION_SECRET), for checking
# API tokens. Generate once, put the same value in both places.
ATLAS_INTROSPECTION_SECRET=
