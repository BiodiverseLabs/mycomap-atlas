{
  "openapi": "3.1.0",
  "info": {
    "title": "MycoMap Atlas API",
    "version": "0.1.0-dev",
    "summary": "Habitat models for North American fungi, built only from DNA-validated MycoMap records.",
    "description": "Every route is a read. Nothing here returns an exact collection coordinate: collection points are aggregated to 0.1 degree cells, and published rasters are 1 km or coarser.\n\nThis file is the contract. The web app's developer page is drawn from it, and a test in tests/testthat/test-openapi.R fails when a route in inst/plumber/atlas.R and this file disagree, so the documentation cannot drift from the code.\n\nReads are open: no account and no token are needed for anything the site's own pages use — taxa, scores, map images, collection cells. Two things need you to be known: downloading a model's GeoTIFF raster, and a higher rate limit. Either sign in on the site with your mycomap.org account, or send a token as \"Authorization: Bearer <token>\". Tokens are issued through a mycomap.org account at https://mycomap.org/atlas-tokens. A token mycomap.org does not recognise, or has revoked, is refused with 401 rather than served at the anonymous rate.\n\nEvery caller is rate limited: anonymous callers per address, signed-in people per person, tokens per token. Over the limit the answer is 429 with Retry-After in seconds. x-rate-limits at the end of this file gives the limits.",
    "license": {
      "name": "GPL-3.0-or-later (code). Terms for published maps follow their source layers.",
      "identifier": "GPL-3.0-or-later"
    },
    "contact": {
      "name": "MycoMap Atlas on GitHub",
      "url": "https://github.com/BiodiverseLabs/mycomap-atlas"
    }
  },
  "servers": [
    {
      "url": "https://atlas.mycomap.org",
      "description": "Public site"
    },
    {
      "url": "http://127.0.0.1:5100",
      "description": "Your own copy, started with ./atlas api"
    }
  ],
  "tags": [
    {
      "name": "Status",
      "description": "What the data behind the API is, and when it was pulled."
    },
    {
      "name": "Taxa",
      "description": "Every taxon in the validated universe, with its record and locality counts."
    },
    {
      "name": "Models",
      "description": "Fitted habitat models: scores, settings and maps."
    },
    {
      "name": "Data",
      "description": "Environmental layers and benchmarks."
    },
    {
      "name": "Access",
      "description": "Who you are to the API, and the downloads that need an account or a token."
    }
  ],
  "paths": {
    "/api/openapi.json": {
      "get": {
        "tags": [
          "Status"
        ],
        "operationId": "getOpenApi",
        "summary": "This description of the API",
        "description": "The OpenAPI 3.1 document you are reading. Point a client generator at it.",
        "responses": {
          "200": {
            "description": "The OpenAPI document.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/X-RateLimit-Limit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/X-RateLimit-Remaining"
              },
              "X-Atlas-Tier": {
                "$ref": "#/components/headers/X-Atlas-Tier"
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/InvalidToken"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/api/sources": {
      "get": {
        "tags": [
          "Data"
        ],
        "operationId": "getSources",
        "summary": "Datasets, software, papers and data products",
        "description": "Every dataset and package Atlas is built on, with links, licences and citations; the papers behind each method; and every file the pipeline produces, with whether and where it is published.",
        "responses": {
          "200": {
            "description": "The sources.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Sources"
                }
              }
            },
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/X-RateLimit-Limit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/X-RateLimit-Remaining"
              },
              "X-Atlas-Tier": {
                "$ref": "#/components/headers/X-Atlas-Tier"
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/InvalidToken"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/api/status": {
      "get": {
        "tags": [
          "Status"
        ],
        "operationId": "getStatus",
        "summary": "What the current pull holds",
        "description": "The size and fingerprint of the record set every model on this server was fitted from. The fingerprint changes whenever any record changes, so it is the thing to cite alongside a map.",
        "responses": {
          "200": {
            "description": "The current pull, or ready: false when none has been made.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            },
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/X-RateLimit-Limit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/X-RateLimit-Remaining"
              },
              "X-Atlas-Tier": {
                "$ref": "#/components/headers/X-Atlas-Tier"
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/InvalidToken"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "tags": [
          "Access"
        ],
        "operationId": "getMe",
        "summary": "Whether you are signed in, and how",
        "description": "For a page's header, or to check a token works. Never returns your mycomap.org account id. Not cached by any shared cache.",
        "responses": {
          "200": {
            "description": "Who the API takes you for.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            },
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/X-RateLimit-Limit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/X-RateLimit-Remaining"
              },
              "X-Atlas-Tier": {
                "$ref": "#/components/headers/X-Atlas-Tier"
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/InvalidToken"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/api/layers": {
      "get": {
        "tags": [
          "Data"
        ],
        "operationId": "getLayers",
        "summary": "Environmental layers",
        "description": "Every registered environmental layer with its source, licence and citation, and whether it is built on the requested grid.",
        "parameters": [
          {
            "$ref": "#/components/parameters/grid"
          }
        ],
        "responses": {
          "200": {
            "description": "The layers on that grid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LayersResponse"
                }
              }
            },
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/X-RateLimit-Limit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/X-RateLimit-Remaining"
              },
              "X-Atlas-Tier": {
                "$ref": "#/components/headers/X-Atlas-Tier"
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/InvalidToken"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/api/taxa": {
      "get": {
        "tags": [
          "Taxa"
        ],
        "operationId": "listTaxa",
        "summary": "Search and list taxa",
        "description": "Taxa in the validated universe, whether or not they have a map yet. A name match is a case-insensitive substring match.",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "description": "Part of a scientific name.",
            "schema": {
              "type": "string",
              "default": ""
            },
            "example": "Mycena"
          },
          {
            "name": "min_localities",
            "in": "query",
            "description": "Only taxa with at least this many independent (about 1 km) localities.",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "example": 20
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Page size.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 100
            },
            "example": 10
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Rows to skip, for paging.",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One page of taxa and the total that matched.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaxaPage"
                }
              }
            },
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/X-RateLimit-Limit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/X-RateLimit-Remaining"
              },
              "X-Atlas-Tier": {
                "$ref": "#/components/headers/X-Atlas-Tier"
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/InvalidToken"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/api/taxa/{name}": {
      "get": {
        "tags": [
          "Taxa"
        ],
        "operationId": "getTaxon",
        "summary": "One taxon's counts",
        "parameters": [
          {
            "$ref": "#/components/parameters/name"
          }
        ],
        "responses": {
          "200": {
            "description": "The taxon.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Taxon"
                }
              }
            },
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/X-RateLimit-Limit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/X-RateLimit-Remaining"
              },
              "X-Atlas-Tier": {
                "$ref": "#/components/headers/X-Atlas-Tier"
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/InvalidToken"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/api/taxa/{name}/cells": {
      "get": {
        "tags": [
          "Taxa"
        ],
        "operationId": "getTaxonCells",
        "summary": "Where a taxon has been collected",
        "description": "Validated collections grouped into 0.1 degree cells, each with the number of records in it. The centre of the cell is given, never a collection point. An unknown name returns an empty list.",
        "parameters": [
          {
            "$ref": "#/components/parameters/name"
          }
        ],
        "responses": {
          "200": {
            "description": "The occupied cells.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Cells"
                }
              }
            },
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/X-RateLimit-Limit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/X-RateLimit-Remaining"
              },
              "X-Atlas-Tier": {
                "$ref": "#/components/headers/X-Atlas-Tier"
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/InvalidToken"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/api/taxa/{name}/model": {
      "get": {
        "tags": [
          "Models"
        ],
        "operationId": "getTaxonModel",
        "summary": "One taxon's fitted model",
        "description": "Scores on every spatial fold, the predictors used, the settings and the map's bounds.",
        "parameters": [
          {
            "$ref": "#/components/parameters/name"
          },
          {
            "$ref": "#/components/parameters/grid"
          },
          {
            "$ref": "#/components/parameters/algorithm"
          }
        ],
        "responses": {
          "200": {
            "description": "The model.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Model"
                }
              }
            },
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/X-RateLimit-Limit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/X-RateLimit-Remaining"
              },
              "X-Atlas-Tier": {
                "$ref": "#/components/headers/X-Atlas-Tier"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadAlgorithm"
          },
          "401": {
            "$ref": "#/components/responses/InvalidToken"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/api/taxa/{name}/map.png": {
      "get": {
        "tags": [
          "Models"
        ],
        "operationId": "getTaxonMap",
        "summary": "A taxon's habitat map as an image",
        "description": "A PNG in web-map coordinates, ready to lay over a slippy map at the bounds the model route gives. Colours are ranks within the model's own accessible area, darkest green highest; outside that area the image is transparent. Add any v= query value to bust a cache.",
        "parameters": [
          {
            "$ref": "#/components/parameters/name"
          },
          {
            "$ref": "#/components/parameters/grid"
          },
          {
            "$ref": "#/components/parameters/algorithm"
          }
        ],
        "responses": {
          "200": {
            "description": "The map.",
            "content": {
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            },
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/X-RateLimit-Limit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/X-RateLimit-Remaining"
              },
              "X-Atlas-Tier": {
                "$ref": "#/components/headers/X-Atlas-Tier"
              }
            }
          },
          "400": {
            "description": "Unknown algorithm. The body is empty."
          },
          "401": {
            "$ref": "#/components/responses/InvalidToken"
          },
          "404": {
            "description": "No map for this taxon and model. The body is empty."
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/api/taxa/{name}/raster.tif": {
      "get": {
        "tags": [
          "Models"
        ],
        "operationId": "getTaxonRaster",
        "summary": "A taxon's habitat raster as a GeoTIFF (sign in or token)",
        "description": "The raw suitability values the map is drawn from, on the model's grid, for GIS work. Needs a signed-in session or an active token; anonymous callers get 401 with a link to sign in. On the public server the answer is a 302 to a download link that works for five minutes; follow redirects (curl -L). Saved as <taxon>-<algorithm>.tif.",
        "security": [
          {
            "atlasToken": []
          },
          {
            "atlasSession": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/name"
          },
          {
            "$ref": "#/components/parameters/grid"
          },
          {
            "$ref": "#/components/parameters/algorithm"
          }
        ],
        "responses": {
          "200": {
            "description": "The GeoTIFF, when this server holds it itself.",
            "content": {
              "image/tiff": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            },
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/X-RateLimit-Limit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/X-RateLimit-Remaining"
              },
              "X-Atlas-Tier": {
                "$ref": "#/components/headers/X-Atlas-Tier"
              }
            }
          },
          "302": {
            "description": "Go to Location for the file: a presigned link that works for five minutes.",
            "headers": {
              "Location": {
                "description": "The download link.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadAlgorithm"
          },
          "401": {
            "$ref": "#/components/responses/SignInRequired"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "503": {
            "description": "The release store could not be reached, or a link could not be made. Try again shortly.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/models": {
      "get": {
        "tags": [
          "Models"
        ],
        "operationId": "listModels",
        "summary": "Every fitted model",
        "description": "One light row per taxon and model, newest first. Fetch a single model for its folds and settings.",
        "parameters": [
          {
            "$ref": "#/components/parameters/grid"
          }
        ],
        "responses": {
          "200": {
            "description": "The models on that grid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelsResponse"
                }
              }
            },
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/X-RateLimit-Limit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/X-RateLimit-Remaining"
              },
              "X-Atlas-Tier": {
                "$ref": "#/components/headers/X-Atlas-Tier"
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/InvalidToken"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/api/algorithms": {
      "get": {
        "tags": [
          "Models"
        ],
        "operationId": "listAlgorithms",
        "summary": "The models Atlas fits",
        "description": "Each algorithm's id, as used in the algorithm parameter, mapped to the label people see.",
        "responses": {
          "200": {
            "description": "Algorithm ids and labels.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "example": {
                  "maxnet": "Maxent",
                  "xgboost": "Boosted trees",
                  "rf": "Random forest"
                }
              }
            },
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/X-RateLimit-Limit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/X-RateLimit-Remaining"
              },
              "X-Atlas-Tier": {
                "$ref": "#/components/headers/X-Atlas-Tier"
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/InvalidToken"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/api/benchmarks/latest": {
      "get": {
        "tags": [
          "Data"
        ],
        "operationId": "getLatestBenchmark",
        "summary": "The newest model benchmark",
        "description": "Every model scored on the same spatial folds for the same taxa, with paired differences from Maxent by band of presence cells.",
        "parameters": [
          {
            "$ref": "#/components/parameters/grid"
          }
        ],
        "responses": {
          "200": {
            "description": "The benchmark.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Benchmark"
                }
              }
            },
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/X-RateLimit-Limit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/X-RateLimit-Remaining"
              },
              "X-Atlas-Tier": {
                "$ref": "#/components/headers/X-Atlas-Tier"
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/InvalidToken"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "name": {
        "name": "name",
        "in": "path",
        "required": true,
        "description": "Scientific name exactly as Atlas lists it, percent-encoded. Provisional names keep their quotes, e.g. Mycena sp. 'IN10'.",
        "schema": {
          "type": "string"
        },
        "example": "Trametes versicolor"
      },
      "grid": {
        "name": "grid",
        "in": "query",
        "description": "draft is 5 km; production is 1 km.",
        "schema": {
          "type": "string",
          "enum": [
            "draft",
            "production"
          ],
          "default": "draft"
        }
      },
      "algorithm": {
        "name": "algorithm",
        "in": "query",
        "description": "Which model: maxnet (Maxent), xgboost (boosted trees) or rf (down-sampled random forest).",
        "schema": {
          "type": "string",
          "enum": [
            "maxnet",
            "xgboost",
            "rf"
          ],
          "default": "maxnet"
        }
      }
    },
    "responses": {
      "NotFound": {
        "description": "Nothing under that name.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "BadAlgorithm": {
        "description": "The algorithm is not one Atlas fits.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "TooManyRequests": {
        "description": "Over the rate limit. Wait Retry-After seconds, or sign in or use a token for a higher limit.",
        "headers": {
          "Retry-After": {
            "description": "Seconds to wait.",
            "schema": {
              "type": "integer"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string"
                },
                "retry_after": {
                  "type": "integer"
                }
              }
            }
          }
        }
      },
      "InvalidToken": {
        "description": "The Bearer token is not valid: unknown, pending approval, disabled, revoked, for another service, or its account is inactive.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string"
                },
                "reason": {
                  "type": "string",
                  "enum": [
                    "unknown",
                    "pending",
                    "disabled",
                    "revoked",
                    "account_inactive",
                    "wrong_service"
                  ]
                }
              }
            }
          }
        }
      },
      "SignInRequired": {
        "description": "Not signed in and no active token, or the token is not valid. Sign in at signIn, or send Authorization: Bearer <token>.",
        "headers": {
          "WWW-Authenticate": {
            "description": "Bearer",
            "schema": {
              "type": "string"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string"
                },
                "signIn": {
                  "type": "string",
                  "description": "Where a browser goes to sign in: /auth/dev-bridge/start."
                },
                "reason": {
                  "type": "string",
                  "description": "Why a token was refused, when one was sent."
                }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "What went wrong, in words."
          }
        }
      },
      "Status": {
        "type": "object",
        "required": [
          "ready"
        ],
        "properties": {
          "ready": {
            "type": "boolean",
            "description": "False until a pull or release is present."
          },
          "pulledAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the records were read from mycomap.org."
          },
          "records": {
            "type": "integer",
            "description": "Validated records in the pull."
          },
          "taxa": {
            "type": "integer",
            "description": "Distinct taxa in the pull."
          },
          "fingerprint": {
            "type": "string",
            "description": "Hash of the whole record set."
          },
          "since": {
            "type": "string",
            "description": "For an incremental pull, the date it started from. Absent for a full pull."
          }
        }
      },
      "Layer": {
        "type": "object",
        "required": [
          "id",
          "title",
          "source",
          "license",
          "citation",
          "built"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "description": "Where the raw data comes from."
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "The provider's download page. Absent for layers derived on the grid."
          },
          "license": {
            "type": "string"
          },
          "citation": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "built": {
            "type": "boolean",
            "description": "Whether the layer exists on this grid."
          },
          "bands": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Predictor names the layer provides."
          },
          "cellSizeM": {
            "type": "number",
            "description": "Cell size in metres."
          },
          "sizeMb": {
            "type": "number"
          },
          "builtAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "LayersResponse": {
        "type": "object",
        "required": [
          "grid",
          "layers"
        ],
        "properties": {
          "grid": {
            "type": "string"
          },
          "layers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Layer"
            }
          }
        }
      },
      "Taxon": {
        "type": "object",
        "required": [
          "scientific_name",
          "records",
          "localities",
          "fingerprint"
        ],
        "properties": {
          "scientific_name": {
            "type": "string"
          },
          "records": {
            "type": "integer",
            "description": "Validated records under this name."
          },
          "localities": {
            "type": "integer",
            "description": "Distinct places about 1 km apart. A better guide than records to what a model can learn."
          },
          "fingerprint": {
            "type": "string",
            "description": "Hash of this taxon's record set. A model is refitted when it changes."
          }
        }
      },
      "TaxaPage": {
        "type": "object",
        "required": [
          "total",
          "items"
        ],
        "properties": {
          "total": {
            "type": "integer",
            "description": "Taxa that matched, across all pages."
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Taxon"
            }
          }
        }
      },
      "Cell": {
        "type": "object",
        "required": [
          "lat",
          "lng",
          "records"
        ],
        "properties": {
          "lat": {
            "type": "number",
            "description": "Latitude of the cell's centre."
          },
          "lng": {
            "type": "number",
            "description": "Longitude of the cell's centre."
          },
          "records": {
            "type": "integer"
          }
        }
      },
      "Cells": {
        "type": "object",
        "required": [
          "name",
          "degrees",
          "cells"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "degrees": {
            "type": "number",
            "description": "Cell size in degrees."
          },
          "cells": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Cell"
            }
          }
        }
      },
      "ModelFold": {
        "type": "object",
        "properties": {
          "fold": {
            "type": "integer"
          },
          "presences": {
            "type": "integer",
            "description": "Presence cells held out in this fold."
          },
          "auc": {
            "type": [
              "number",
              "null"
            ],
            "description": "Null when the fold held too few presences to score."
          },
          "boyce": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      },
      "ModelBounds": {
        "type": "object",
        "properties": {
          "south": {
            "type": "number"
