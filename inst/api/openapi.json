        "properties": {
          "signedIn": {
            "type": "boolean",
            "description": "True with a signed-in session or an active token."
          },
          "name": {
            "type": "string",
            "description": "Your public display name on mycomap.org, when signed in on the site."
          },
          "via": {
            "type": "string",
            "enum": [
              "session",
              "token"
            ],
            "description": "How you are known."
          },
          "tier": {
            "type": "string",
            "enum": [
              "standard",
              "bulk"
            ],
            "description": "The rate limit you get."
          },
          "signInAvailable": {
            "type": "boolean",
            "description": "Whether this server can sign people in."
          }
        }
      }
    },
    "securitySchemes": {
      "atlasToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Optional for reading. A token from https://mycomap.org/atlas-tokens, sent as Authorization: Bearer <token>, raises your rate limit and lets you download rasters."
      },
      "atlasSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-atlas_session",
        "description": "Set in a browser by signing in with a mycomap.org account at /auth/dev-bridge/start."
      }
    },
    "headers": {
      "X-RateLimit-Limit": {
        "description": "Requests per minute allowed for this caller.",
        "schema": {
          "type": "integer"
        }
      },
      "X-RateLimit-Remaining": {
        "description": "Requests left before the limit.",
        "schema": {
          "type": "integer"
        }
      },
      "X-Atlas-Tier": {
        "description": "anonymous, standard or bulk.",
        "schema": {
          "type": "string"
        }
      }
    }
  },
  "x-rate-limits": {
    "unit": "requests per minute",
    "anonymous": 300,
    "standard": 1200,
    "bulk": 6000
  },
  "security": [
    {},
    {
      "atlasToken": []
    },
    {
      "atlasSession": []
    }
  ]
}
