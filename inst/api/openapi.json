                "id",
                "name",
                "url",
                "license",
                "role"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "provider": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "license": {
                  "type": "string"
                },
                "license_url": {
                  "type": "string",
                  "format": "uri"
                },
                "role": {
                  "type": "string"
                },
                "citation": {
                  "type": "string"
                },
                "doi": {
                  "type": "string"
                }
              }
            }
          },
          "software": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "group",
                "license",
                "url",
                "role"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "group": {
                  "type": "string",
                  "enum": [
                    "platform",
                    "r",
                    "web"
                  ]
                },
                "version": {
                  "type": "string"
                },
                "license": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "role": {
                  "type": "string"
                },
                "citation": {
                  "type": "string"
                },
                "doi": {
                  "type": "string"
                }
              }
            }
          },
          "references": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "citation",
                "used_for"
              ],
              "properties": {
                "citation": {
                  "type": "string"
                },
                "doi": {
                  "type": "string"
                },
                "used_for": {
                  "type": "string"
                }
              }
            }
          },
          "products": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "stage",
                "name",
                "detail",
                "availability"
              ],
              "properties": {
                "stage": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "detail": {
                  "type": "string"
                },
                "availability": {
                  "type": "string",
                  "enum": [
                    "published",
                    "in releases",
                    "planned",
                    "at source",
                    "withheld"
                  ]
                },
                "where": {
                  "type": "string"
                },
                "why": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "Benchmark": {
        "type": "object",
        "description": "Settings, a summary by band of presence cells, and each taxon's scores under every model.",
        "properties": {
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "baseline": {
            "type": "string"
          },
          "settings": {
            "type": "object"
          },
          "summary": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "taxa": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "Me": {
        "type": "object",
        "required": [
          "signedIn",
          "signInAvailable"
