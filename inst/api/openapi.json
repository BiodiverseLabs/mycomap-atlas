          "auc_mean": {
            "type": "number"
          },
          "boyce_mean": {
            "type": "number"
          },
          "map": {
            "type": "boolean"
          },
          "built_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ModelsResponse": {
        "type": "object",
        "required": [
          "grid",
