            "type": "number"
          },
          "north": {
            "type": "number"
          },
          "east": {
            "type": "number"
          }
        }
      },
      "Model": {
        "type": "object",
        "required": [
          "taxon",
          "grid",
          "presences",
          "background",
          "predictors",
          "folds",
          "auc_mean",
          "boyce_mean",
          "built_at"
        ],
        "properties": {
          "taxon": {
            "type": "string"
          },
          "algorithm": {
            "type": "string",
            "enum": [
              "maxnet",
              "xgboost",
              "rf"
            ],
            "description": "Absent on the oldest Maxent models, which are Maxent."
          },
          "algorithm_label": {
            "type": "string"
          },
          "grid": {
            "type": "string"
          },
          "presences": {
            "type": "integer",
            "description": "Occupied grid cells the model learned from."
          },
          "background": {
            "type": "integer",
            "description": "Background cells drawn from other validated collections."
          },
          "area_km2": {
            "type": "number",
            "description": "The accessible area: the taxon's cells buffered by 500 km."
          },
          "predictors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "predictors_considered": {
            "type": "integer"
          },
          "classes": {
            "type": "string",
            "description": "Maxent feature classes, e.g. lqh."
          },
          "nrounds": {
            "type": "integer",
            "description": "Boosted trees: the tree count early stopping chose."
          },
          "block_km": {
            "type": "number",
            "description": "Size of the spatial blocks folds hold out."
          },
          "folds": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ModelFold"
            }
          },
          "auc_mean": {
            "type": "number",
            "description": "Mean blocked AUC. 0.5 is chance."
          },
          "auc_sd": {
            "type": "number"
          },
          "boyce_mean": {
            "type": "number",
            "description": "Mean blocked Boyce index, from -1 to 1."
          },
          "boyce_sd": {
            "type": "number"
          },
          "built_at": {
            "type": "string",
            "format": "date-time"
          },
          "map": {
            "type": "string",
            "description": "Present when a map was drawn."
          },
          "bounds": {
            "$ref": "#/components/schemas/ModelBounds"
          },
          "map_scale": {
            "type": "string",
            "description": "rank: colours are percentiles within the map."
          },
          "map_drawn_at": {
            "type": "string",
            "format": "date-time"
          },
          "cells_without_data": {
            "type": "integer",
            "description": "Cells in the accessible area with a missing predictor, left out of fitting and prediction."
          },
          "correlation": {
            "type": [
              "number",
              "null"
            ],
            "description": "Correlation above which predictors were pruned; null when the model uses all of them."
          },
          "regmult": {
            "type": "number",
            "description": "Maxent regularisation multiplier."
          },
          "seed": {
            "type": "integer",
            "description": "Random seed, derived from the record-set fingerprint."
          },
          "fingerprint": {
            "type": "string",
            "description": "Hash of the record set the model was fitted on."
          },
          "settings": {
            "type": "object",
            "description": "Every setting that decides the fit apart from the records, including the layer builds."
          },
          "settings_key": {
            "type": "string",
            "description": "Hash of settings. With fingerprint, it decides whether the model is current."
          },
          "raster": {
            "type": "string",
            "description": "File name of the raw suitability GeoTIFF in a release."
          },
          "md5": {
            "type": "string",
            "description": "MD5 of that GeoTIFF."
          },
          "r_version": {
            "type": "string"
          },
          "terra_version": {
            "type": "string"
          },
          "maxnet_version": {
            "type": "string"
          },
          "package": {
            "type": "string",
            "description": "The R package that fitted the model."
          },
          "package_version": {
            "type": "string"
          }
        }
      },
      "ModelSummary": {
        "type": "object",
        "properties": {
          "taxon": {
            "type": "string"
